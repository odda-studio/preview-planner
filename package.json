{
  "name": "base-cms",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "watch:core-library": "ng build core-library --watch",
    "watch:odda-planner": "ng build odda-planner --watch",
    "runAll": "npm run watch:core-library & npm run watch:odda-planner & npm run start",
    "build:library": "ng build core-library && ng build odda-planner",
    "serve:ssr:base-cms": "node dist/base-cms/server/server.mjs",
    "generate-api": "openapi-generator-cli generate -i http://localhost:5090/swagger/v1/swagger.json -g typescript-angular -o projects/odda-planner/src/lib/api -c openapi.config.json --skip-validate-spec",
    "generate-api-library": "openapi-generator-cli generate -i http://localhost:5090/swagger/v1/swagger.json -g typescript-angular -o projects/core-library/src/lib/base-crud-admin/models -c openapi.config.json --skip-validate-spec --global-property models"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/material-luxon-adapter": "^21.1.2",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.5",
    "@tinymce/tinymce-angular": "^9.1.1",
    "emitter": "^0.0.5",
    "express": "^5.1.0",
    "html-pdf-node": "^1.0.8",
    "jspreadsheet-ce": "^5.0.4",
    "jszip": "^3.10.1",
    "luxon": "^3.7.2",
    "monaco-editor": "^0.55.1",
    "monaco-types": "^0.1.2",
    "ngx-extended-pdf-viewer": "^27.0.0",
    "rxjs": "~7.8.0",
    "tinymce": "^8.3.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.5",
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.0",
    "@openapitools/openapi-generator-cli": "^2.13.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
