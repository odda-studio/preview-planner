  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch:core-library",
      "type": "npm",
      "script": "watch:core-library",
      "isBackground": true,
      "presentation": {
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "watch:odda-planner",
      "type": "npm",
      "script": "watch:odda-planner",
      "isBackground": true,
      "presentation": {
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "serve",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "presentation": {
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "runAll",
      "dependsOrder": "parallel",
      "dependsOn": [
        "watch:core-library",
        "watch:odda-planner",
        "serve"
      ]
    },
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    }
  ]
}
